{
  "name": "serverless-agent-monorepo",
  "private": true,
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r --workspace-concurrency=1 run build",
    "test": "pnpm -r --workspace-concurrency=1 --filter \"!@serverless-agent/integration-tests\" run test",
    "typecheck": "pnpm build && pnpm -r run typecheck",
    "synth": "pnpm --filter @serverless-agent/example-basic run synth",
    "local:up": "docker compose up -d --wait",
    "local:down": "docker compose down -v",
    "local:deploy": "node scripts/with-localstack-env.mjs --require-token node -e 0 && pnpm build && pnpm synth && node scripts/with-localstack-env.mjs node examples/basic/scripts/deploy-local.mjs",
    "test:integration": "node scripts/with-localstack-env.mjs --skip-without-token pnpm --filter @serverless-agent/integration-tests run test"
  }
}
